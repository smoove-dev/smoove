{
  "name": "@smoove/cli",
  "version": "0.5.3",
  "description": "The smoove command: run and build the studio, create compositions, and give coding agents their view of the studio.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smoove-dev/smoove.git",
    "directory": "packages/cli"
  },
  "homepage": "https://smoove.dev",
  "bugs": "https://github.com/smoove-dev/smoove/issues",
  "type": "module",
  "main": "./dist/main.js",
  "module": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "bin": {
    "smoove": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@babel/parser": "^7.29.0",
    "@clack/prompts": "^1.6.0",
    "@mediabunny/server": "^1.49.0",
    "@modelcontextprotocol/server": "^2.3.1",
    "@smoove/agent": "workspace:^",
    "@smoove/media": "workspace:^",
    "@smoove/studio": "workspace:^",
    "mediabunny": "^1.49.0",
    "skia-canvas": "^3.0.8",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^22.10.0",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
