{
  "name": "@smoove/studio",
  "version": "0.4.2",
  "description": "Composable React studio UI for smoove: catalog, stage, timeline, props form, and render dialogs.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smoove-dev/smoove.git",
    "directory": "packages/studio"
  },
  "homepage": "https://smoove.dev",
  "bugs": "https://github.com/smoove-dev/smoove/issues",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./styles.css": "./dist/styles/studio.css",
    "./vite": {
      "types": "./dist/preset/vite-plugin.d.ts",
      "import": "./dist/preset/vite-plugin.js"
    },
    "./virtual": {
      "types": "./virtual.d.ts"
    },
    "./preset": {
      "types": "./dist/preset/index.d.ts",
      "import": "./dist/preset/index.js"
    },
    "./tsconfig.json": "./tsconfig.project.json"
  },
  "files": [
    "dist",
    "virtual.d.ts",
    "template",
    "tsconfig.project.json"
  ],
  "scripts": {
    "build": "tsc -b && pnpm run build:css",
    "build:css": "tailwindcss -i ./src/studio.css -o ./dist/styles/studio.css --minify",
    "dev": "concurrently -k \"tsc -b --watch --preserveWatchOutput\" \"tailwindcss -i ./src/studio.css -o ./dist/styles/studio.css --watch\"",
    "clean": "rm -rf dist *.tsbuildinfo",
    "prepublishOnly": "pnpm build",
    "test": "vitest run"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@smoove/agent": "workspace:^",
    "@smoove/core": "workspace:^",
    "@smoove/player": "workspace:^",
    "@smoove/renderer": "workspace:^",
    "signal-polyfill": "^0.2.2",
    "@smoove/vite": "workspace:^"
  },
  "peerDependencies": {
    "konva": ">=10",
    "react": ">=18",
    "react-dom": ">=18",
    "vite": ">=8",
    "@react-router/dev": ">=8",
    "@react-router/serve": ">=8",
    "react-router": ">=8",
    "vitest": ">=3"
  },
  "peerDependenciesMeta": {
    "@smoove/renderer": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "concurrently": "^9.1.0",
    "tailwindcss": "^4.3.0",
    "vitest": "^3.2.4",
    "vite": "^8.0.0",
    "@react-router/dev": "^8.1.0",
    "@react-router/serve": "^8.1.0",
    "react-router": "^8.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
